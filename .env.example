PORT=3000
PGHOST=localhost
PGPORT=5432
PGUSER=judici_app
PGPASSWORD=change-me
PGDATABASE=judicia_a
PSQL_PATH=C:\Program Files\PostgreSQL\16\bin\psql.exe
JEVMODEL_API_KEY=
JEVMODEL_BASE_URL=http://127.0.0.1:8000/v1/systemone
JEVMODEL_NAME=multilingual
TRIAGE_AUTOMATION_APPROVED=false
# Configure uma chave longa para proteger salvamento e prévias da triagem.
TRIAGE_SETTINGS_KEY=
# Use true behind HTTPS in the production environment.
SESSION_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TICKETING_PROVIDER=mock
# GLPI 11 API v2. Keep empty while using the mock connector.
# Base URL is the API root published by your instance, commonly https://glpi.example.org/api.php
GLPI_API_BASE_URL=
GLPI_CLIENT_ID=
GLPI_CLIENT_SECRET=
GLPI_USERNAME=
GLPI_PASSWORD=
GLPI_API_SCOPE=api
GLPI_API_VERSION=v2
GLPI_KNOWLEDGE_RESOURCE=Knowledgebase/Article
GLPI_QUEUE_CATEGORY_IDS=
